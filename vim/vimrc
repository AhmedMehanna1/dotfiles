" Plugin-free Vim for servers / sudo edits. Daily driver is Neovim (~/.config/nvim).
" Leader keys mirror ~/.ideavimrc and the Neovim config where Vim can do them alone.
set nocompatible
filetype plugin indent on
syntax on

set number relativenumber cursorline scrolloff=5 signcolumn=yes
set tabstop=4 shiftwidth=4 expandtab autoindent
set ignorecase smartcase incsearch hlsearch
set noswapfile hidden splitright splitbelow
set wildmenu wildmode=longest:full,full wildignore+=*/target/*,*/.git/*,*.o
set path=.,** clipboard=unnamedplus mouse=a
set backspace=indent,eol,start laststatus=2
if executable('rg') | set grepprg=rg\ --vimgrep grepformat=%f:%l:%c:%m | endif

let mapleader = ' '
let g:netrw_banner = 0

nnoremap <Leader>ff :find<Space>
nnoremap <Leader>fs :grep<Space>
nnoremap <Leader>fb :ls<CR>:buffer<Space>
nnoremap <Leader>fr :browse oldfiles<CR>
nnoremap <Leader>ee :Explore<CR>
nnoremap <Leader>sv :vsplit<CR>
nnoremap <Leader>sh :split<CR>
nnoremap <Leader>cc :make<CR>:cwindow<CR>
nnoremap <Leader>xo :%bdelete<Bar>edit#<Bar>bdelete#<CR>

nnoremap <silent> <C-j> :m .+1<CR>==
nnoremap <silent> <C-k> :m .-2<CR>==
inoremap <silent> <C-j> <Esc>:m .+1<CR>==gi
inoremap <silent> <C-k> <Esc>:m .-2<CR>==gi
vnoremap <silent> <C-j> :m '>+1<CR>gv=gv
vnoremap <silent> <C-k> :m '<-2<CR>gv=gv
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
